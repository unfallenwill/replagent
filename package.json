{
  "name": "replagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A terminal agent whose only language - and only channel to the world - is a Node.js REPL.",
  "main": "./dist/main.mjs",
  "bin": {
    "replagent": "./dist/main.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli/main.ts",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint . --fix",
    "complexity": "eslint src test eval --max-warnings 0",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "eval": "node --env-file-if-exists=.env.local --import tsx eval/cli.ts",
    "eval:smoke": "npm run eval -- run --mode reference --trials 1",
    "eval:baseline": "npm run eval -- run --mode live --trials 3 --concurrency 3 --out .evals/baseline-v3",
    "eval:regression": "npm run eval -- run --mode live --trials 3 --concurrency 3 --baseline .evals/baseline-v3/report.json",
    "eval:long": "npm run eval -- run --tasks eval/long/tasks.ts --timeout-ms 900000 --max-calls 80 --max-steps 32",
    "eval:long:smoke": "npm run eval:long -- --mode reference --trials 1",
    "eval:experiment": "node --env-file-if-exists=.env.local --import tsx eval/experiments/cli.ts run --timeout-ms 900000 --max-calls 80 --max-steps 32",
    "eval:confirm": "node --env-file-if-exists=.env.local --import tsx eval/experiments/confirm-cli.ts run --timeout-ms 900000 --max-calls 80 --max-steps 32 --trials 10",
    "eval:verify": "node --import tsx eval/verify.ts",
    "eval:repository": "npm run eval -- run --tasks eval/repository/tasks.ts --timeout-ms 900000 --max-calls 80 --max-steps 32",
    "eval:repository:smoke": "npm run eval:repository -- --mode reference --trials 1",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run test && npm run coverage && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "js-beautify": "^2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.0.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.4"
  }
}
